## Shell-invocation guard (see AGENTS.md): re-exec under python3.
"exec" "python3" "-Bsu" "$0" "$@"

import sys
from stem.connection import connect

controller = connect()

if not controller:
    sys.exit(255)

dormant_status = controller.get_info("dormant")

print(format(dormant_status))

controller.close()
