set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

if grep -q "libhardened_malloc" "/proc/$$/maps"; then
    printf '%s\n' "yes"    exit 0
fi

printf '%s\n' "no"exit 1
