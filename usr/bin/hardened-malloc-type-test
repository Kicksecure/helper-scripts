#!/bin/bash

## Copyright (C) 2020 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

if grep --quiet "libhardened_malloc-light.so" "/proc/$$/maps"; then
    printf '%s\n' "light"
    exit 0
fi

if grep --quiet "libhardened_malloc.so" "/proc/$$/maps"; then
    printf '%s\n' "default"
    exit 0
fi

printf '%s\n' "none"
exit 1
