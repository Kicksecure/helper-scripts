set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=./strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

adduser_conf_path="${GET_USER_LIST_ADDUSER_CONF:-/etc/adduser.conf}"
passwd_path="${GET_USER_LIST_PASSWD:-/etc/passwd}"

## Read one key's value from adduser.conf. In case of multiple matches, the
## last match wins.
read_adduser_conf_field() {
  local key line value found

  key="$1"
  value=""
  found="false"

  ## '|| [ -n "${line}" ]' processes a final line lacking a trailing newline.
  while IFS= read -r line || [ -n "${line}" ]; do
    if [[ "${line}" =~ ^[[:space:]]*${key}[[:space:]]*= ]]; then
      value="${line#*=}"
      found="true"
    fi
  done < "${adduser_conf_path}"

  if [ "${found}" = "false" ]; then
    printf '%s' ""
    return 0
  fi

  ## adduser sources adduser.conf as shell, so mirror those semantics: drop a
  ## trailing whitespace-preceded '#' comment, strip surrounding whitespace,
  ## then one layer of matching surrounding quotes.
  value="${value%%[[:space:]]#*}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [ "${#value}" -ge 2 ]; then
    case "${value}" in
      \"*\")
        value="${value:1:${#value}-2}"
        ;;
      \'*\')
        value="${value:1:${#value}-2}"
        ;;
    esac
  fi

  printf '%s' "${value}"
}

if test -r "${adduser_conf_path}"; then
  ## Modern adduser ships FIRST_UID/LAST_UID commented out (defaults are
  ## built into adduser), so an absent/empty field is normal: fall through to
  ## the defaults below. Only a field that is present but non-numeric is an error.
  first_uid="$(read_adduser_conf_field FIRST_UID)"
  if [ -n "${first_uid}" ] && ! is_whole_number "${first_uid}"; then
    printf '%s\n' "$0: ERROR: FIRST_UID in file '${adduser_conf_path}' is not a whole number!" >&2
    exit 1
  fi

  last_uid="$(read_adduser_conf_field LAST_UID)"
  if [ -n "${last_uid}" ] && ! is_whole_number "${last_uid}"; then
    printf '%s\n' "$0: ERROR: LAST_UID in file '${adduser_conf_path}' is not a whole number!" >&2
    exit 1
  fi
fi

if [ -z "${first_uid:-}" ]; then
  first_uid=1000
fi
if [ -z "${last_uid:-}" ]; then
  last_uid=59999
fi

if ! test -r "${passwd_path}"; then
  printf '%s\n' "$0: ERROR: file '${passwd_path}' is not readable!" >&2
  exit 1
fi

## '|| [ -n "${user_entry}" ]' processes a final line lacking a trailing newline.
while read -r user_entry || [ -n "${user_entry}" ]; do
   [ -n "${user_entry}" ] || continue
   current_uid="$(cut -d':' -f3 <<< "${user_entry}")"
   ## Skip a malformed entry (empty / non-numeric UID) cleanly rather than let
   ## the numeric tests below emit '[: integer expression expected' and drop it.
   is_whole_number "${current_uid}" || continue
   if { [ "${current_uid}" -ge "${first_uid}" ] \
      && [ "${current_uid}" -le "${last_uid}" ]; } \
      || [ "${current_uid}" -eq 0 ]; then
      ## In-range users, plus root (numeric compare so a leading-zero UID like
      ## '00' still matches).
      cut -d':' -f1 <<< "${user_entry}"
   fi
done < "${passwd_path}"
