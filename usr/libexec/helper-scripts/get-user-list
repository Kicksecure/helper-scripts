set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Overridable so tests can inject fixtures; production reads the real files.
adduser_conf_path="${GET_USER_LIST_ADDUSER_CONF:-/etc/adduser.conf}"
passwd_path="${GET_USER_LIST_PASSWD:-/etc/passwd}"

## Read one key's value from adduser.conf. The file is shell-sourced by adduser,
## so a duplicated key means the LAST assignment wins. Done in explicit steps for
## clarity; prints the value, or empty if the key is unset.
read_adduser_conf_uid() {
  local key line value found

  key="$1"
  value=""
  found="no"

  ## Step 1+2: walk the file line by line and keep the LAST assignment of the
  ## key. The match is anchored to the line start (after optional whitespace) so
  ## comments ('#...') and substrings (e.g. 'MY_FIRST_UID') are ignored.
  while IFS= read -r line; do
    if [[ "${line}" =~ ^[[:space:]]*${key}[[:space:]]*= ]]; then
      ## Step 3: value is everything after the first '='.
      value="${line#*=}"
      found="yes"
    fi
  done <<< "${adduser_conf_file}"

  ## The key was absent: report empty so the caller applies its default.
  if [ "${found}" = "no" ]; then
    printf '%s' ""
    return 0
  fi

  ## Step 4: strip surrounding whitespace.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf '%s' "${value}"
}

if test -r "${adduser_conf_path}"; then
  adduser_conf_file="$(cat -- "${adduser_conf_path}")"

  first_uid="$(read_adduser_conf_uid FIRST_UID)"
  if [[ "${first_uid}" = *[!0-9]* ]]; then
    printf '%s\n' "$0: ERROR: FIRST_UID in file '${adduser_conf_path}' is not strictly numeric!" >&2
    exit 1
  fi

  last_uid="$(read_adduser_conf_uid LAST_UID)"
  if [[ "${last_uid}" = *[!0-9]* ]]; then
    printf '%s\n' "$0: ERROR: LAST_UID in file '${adduser_conf_path}' is not strictly numeric!" >&2
    exit 1
  fi
fi

if [ -z "${first_uid:-}" ]; then
  first_uid=1000
fi
if [ -z "${last_uid:-}" ]; then
  last_uid=59999
fi

if ! test -r "${passwd_path}"; then
  printf '%s\n' "$0: ERROR: file '${passwd_path}' is not readable!" >&2
  exit 1
fi

while read -r user_entry; do
   current_uid="$(cut -d':' -f3 <<< "${user_entry}")"
   if [ "${current_uid}" -ge "${first_uid}" ] \
      && [ "${current_uid}" -le "${last_uid}" ]; then
      cut -d':' -f1 <<< "${user_entry}"
   elif [ "${current_uid}" = '0' ]; then
      ## Include the root user in the list.
      cut -d':' -f1 <<< "${user_entry}"
   fi
done < "${passwd_path}"
