set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

delay_ctr=0

while (( delay_ctr < 120 )); do
  tor_active_state="$(systemctl --no-pager --no-block show tor@default.service \
    --property ActiveState)"
  case "${tor_active_state}" in
    'ActiveState=active')
      exit 0
      ;;
    'ActiveState=failed')
      ## Fail CLOSED: a caller gating on this must not proceed as if Tor is up
      ## when the service has failed (anonymity-relevant).
      exit 1
      ;;
    *)
      sleep 1
      (( delay_ctr++ )) || true
      ;;
  esac
done

## Timed out without Tor ever becoming active: fail closed.
exit 1
